[Unit]
Description=TrackLog location recorder
Documentation=https://github.com/protongit/harbour-tracklog
After=dbus.service
PartOf=default.target

[Service]
Type=dbus
BusName=org.hensip.tracklog
ExecStart=/usr/bin/tracklogd
Restart=on-failure
RestartSec=5
Nice=10

[Install]
WantedBy=default.target
